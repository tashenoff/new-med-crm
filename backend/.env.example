# интеграция с CallIQ (stt) — если пусто, отправка записей отключена
# CALLIQ_URL=
# CALLIQ_EMAIL=
# CALLIQ_PASSWORD=
# CALLIQ_PROJECT_ID=

# Patient terms: opt-in link issuance; ordinary booking messages work without it.
CONSENT_ENABLED=0
CONSENT_PUBLIC_BASE_URL=
CONSENT_CLINIC_ID=clinic
CONSENT_TOKEN_TTL_HOURS=168
# Development only: CONSENT_ALLOW_LOCALHOST=1

# CallIQ metadata/reconciliation: disabled until separately authorized.
CALLIQ_EVENT_SYNC_ENABLED=false
# Proposed derived missed policy: user acceptance is still pending.
CALLIQ_DERIVED_MISSED_ENABLED=false
CALLIQ_MISSED_QUIET_SECONDS=900
CALLIQ_MISSED_STABLE_SECONDS=600
CALLIQ_RECONCILE_INTERVAL_SECONDS=600
CALLIQ_RECONCILE_INITIAL_DELAY_SECONDS=90
CALLIQ_REVIEW_AFTER_SECONDS=14400
CALLIQ_MISSED_FOLLOWUP_SECONDS=3600
